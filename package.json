{
  "name": "chrome-multiaccountcontainers",
  "version": "0.1.0",
  "description": "Separate sign-ins per tab for Chrome: containers that keep their own cookies and site data, shown as tab groups.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EY4O/Chrome-MultiAccountContainers.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit/",
    "harness": "node harness/server.mjs",
    "e2e": "node test/e2e.mjs",
    "e2e:restart": "node test/e2e-restart.mjs",
    "sandbox": "node sandbox/open.mjs",
    "sandbox:test": "node sandbox/run.mjs",
    "sandbox:phase2": "node sandbox/phase2.mjs",
    "e2e:phase3": "node test/e2e-phase3.mjs",
    "release": "node build.mjs --release",
    "release:check": "node test/release-smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "puppeteer": "^25.16.0",
    "typescript": "^7.0.2"
  }
}
